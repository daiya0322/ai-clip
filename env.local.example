# Vercel（フロントエンド）用 — .env.local にリネームして使う
# ローカル開発時: http://localhost:8000
# 本番: RenderのバックエンドURL（例: https://ai-clip-backend.onrender.com）

# サーバーサイド用（transcript / analyze のプロキシ）
BACKEND_URL=http://localhost:8000

# クライアントサイド用（切り抜き生成をVercelを経由せず直接バックエンドへ送る）
# ※ Vercelにデプロイ後にこれが未設定だと切り抜き生成が失敗します
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
